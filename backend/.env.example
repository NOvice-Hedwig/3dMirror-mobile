# Copy to .env and fill in real values

# 开发模式：跳过真实短信/邮件，验证码固定为 123456
DEV_MODE=false

DATABASE_URL=postgresql://mirror:mirror@localhost/mirror_db

# Generate: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Aliyun SMS (中国手机号)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SEC=
ALIYUN_SMS_SIGN=3D Mirror
ALIYUN_SMS_TEMPLATE=SMS_XXXXXXXX

# Twilio (国际手机号)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# SendGrid (邮件)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@3dmirror.app

# Apple Sign-In
APPLE_BUNDLE_ID=com.yourcompany.3dmirror
